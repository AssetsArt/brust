{
  "name": "@brust/brust",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": { "brust": "./bin/brust" },
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes.ts",
    "./server": "./src/server.ts",
    "./native": "./native/index.js"
  },
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts --manifest-path ../../crates/brust-napi/Cargo.toml --output-dir native",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts --manifest-path ../../crates/brust-napi/Cargo.toml --output-dir native",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p ."
  },
  "napi": {
    "binaryName": "brust",
    "packageName": "@brust/native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "dependencies": { "@brust/runtime-dom": "workspace:*" },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
