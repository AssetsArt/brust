{
  "name": "@brust/core",
  "version": "2.0.0-alpha.10",
  "description": "brust v2 \u2014 React components compiled to Rust-rendered templates",
  "license": "MIT",
  "homepage": "https://brust.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AssetsArt/brust.git",
    "directory": "packages/brust"
  },
  "bugs": {
    "url": "https://github.com/AssetsArt/brust/issues"
  },
  "type": "module",
  "bin": {
    "brust": "./bin/brust"
  },
  "exports": {
    ".": {
      "workerd": "./src/cf.ts",
      "browser": "./src/browser.ts",
      "default": "./src/index.ts"
    },
    "./build-time": "./src/build-time.ts",
    "./routes": "./src/routes.ts",
    "./server": "./src/server.ts",
    "./server-handlers": "./src/server-handlers.ts",
    "./server-handlers/actions": "./src/actions/load.ts",
    "./cache-adapter": "./src/cache-adapter/index.ts",
    "./cache-adapter/conformance": "./src/cache-adapter/conformance.ts",
    "./store": "./src/store/index.ts",
    "./store/react": "./src/store/react.ts",
    "./elysia": "./src/actions/elysia.ts",
    "./client": "./src/actions/client.ts",
    "./native": "./native/index.js"
  },
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts --manifest-path ../../crates/brust-napi/Cargo.toml --output-dir native",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts --manifest-path ../../crates/brust-napi/Cargo.toml --output-dir native",
    "test": "bun test",
    "typecheck": "bun check",
    "build:target": "napi build --platform --release --js index.js --dts index.d.ts --manifest-path ../../crates/brust-napi/Cargo.toml --output-dir native"
  },
  "napi": {
    "binaryName": "brust",
    "packageName": "@brust/native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "dependencies": {
    "@brust/runtime-dom": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "elysia": "2.0.0-beta.30",
    "@elysia/eden": "2.0.0-beta.6"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    },
    "@elysia/eden": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elysia/eden": "2.0.0-beta.6",
    "@napi-rs/cli": "^3.0.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.0",
    "elysia": "2.0.0-beta.30",
    "lucide-react": "1.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "bin",
    "native/index.js",
    "native/index.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@brust/native-darwin-x64": "workspace:*",
    "@brust/native-darwin-arm64": "workspace:*",
    "@brust/native-linux-x64-gnu": "workspace:*",
    "@brust/native-linux-arm64-gnu": "workspace:*",
    "@brust/native-linux-x64-musl": "workspace:*",
    "@brust/native-linux-arm64-musl": "workspace:*",
    "@brust/core-cf": "workspace:*"
  }
}
