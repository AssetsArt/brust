{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noUncheckedIndexedAccess": true,
    "noEmit": true, "types": ["bun"], "skipLibCheck": true, "jsx": "react-jsx"
  },
  "include": ["src", "test", "bin", "scripts"],
  "exclude": ["templates", "template-overlays", "**/dist"]
}
