{
  // Declaration-only emit for the published package (`bun run build:dts`).
  //
  // Consumers' tsc must see .d.ts (skippable via skipLibCheck) instead of
  // typechecking brust's raw .ts internals — Bun keeps EXECUTING the raw .ts
  // via the exports map's `default` condition; this config only produces the
  // `types` condition targets under types/ (gitignored, regenerated by
  // prepack). Deliberately non-strict + noEmitOnError:false: the gate is the
  // consumer experience (tests/dts-consumer.test.ts), not our own strictness —
  // full-typecheck tsc stack-overflows on this repo; declaration emit does not.
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": "runtime",
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  // The 7 exports-map entrypoints; tsc pulls in their import graphs.
  "include": [
    "runtime/index.ts",
    "runtime/routes.ts",
    "runtime/client/index.ts",
    "runtime/create.ts",
    "runtime/store/index.ts",
    "runtime/native/index.ts",
    "runtime/navigation/index.ts"
  ]
}
