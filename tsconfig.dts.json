{
  // Declaration-only emit for the published package (`bun run build:dts`).
  //
  // Consumers' tsc must see .d.ts (skippable via skipLibCheck) instead of
  // typechecking brust's raw .ts internals — Bun keeps EXECUTING the raw .ts
  // via the exports map's `default` condition; this config only produces the
  // `types` condition targets under types/ (gitignored, regenerated by
  // prepack). `strict: true` MATCHES the root tsconfig and how the runtime is
  // actually written — `strict: false` (an earlier attempt) breaks
  // discriminated-union narrowing without strictNullChecks and surfaced 7
  // spurious body-level errors as CI annotations on the publish job. Declaration
  // emit is clean under strict; the "tsc stack-overflows" caveat is about
  // FULL-PROGRAM typecheck, not the scoped declaration emit of these entrypoints.
  // build:dts uses `&&` so a real future error fails prepack loudly (no masking).
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": "runtime",
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  // The 7 exports-map entrypoints; tsc pulls in their import graphs.
  "include": [
    "runtime/index.ts",
    "runtime/routes.ts",
    "runtime/client/index.ts",
    "runtime/create.ts",
    "runtime/store/index.ts",
    "runtime/native/index.ts",
    "runtime/navigation/index.ts"
  ]
}
