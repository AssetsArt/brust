#!/bin/sh
# worker-build hard-codes `rustc +nightly`: pin it to rust-toolchain.toml's channel (R8), then run the
# next `rustc` on PATH (this directory removed).
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../../.." && pwd)
chan=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' "$root/rust-toolchain.toml")
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$here" | paste -sd: -)
export PATH
if [ "$1" = "+nightly" ]; then
  echo "[pinned] +nightly -> +$chan (rustc)" >&2
  shift
  exec rustc "+$chan" "$@"
fi
exec rustc "$@"
