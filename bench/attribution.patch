+//! TEMPORARY per-stage attribution (m2p ruling 7d164bb6) — local patch, never commit.
+//! Per-thread accumulators (no cross-thread contention), summed by `/_brust/perf`.
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+use parking_lot::Mutex;
+
+macro_rules! stages {
+    ($($id:ident = $n:expr),* $(,)?) => {
+        $(pub const $id: usize = $n;)*
+        pub static NAMES: &[(usize, &str)] = &[$(($n, stringify!($id))),*];
+    };
+}
+stages! {
+    SVC_TOTAL = 0, HANDLE_TOTAL = 1, PAGE_TOTAL = 2, MATCH = 3, L1 = 4, CTX_INIT = 5,
+    MERGE_LOADER = 21, COLLECT_JOBS = 22, CJ_INPUTS = 23, CJ_KEY = 24, JOB_LOOKUP = 25,
+    JOBS_CALL = 26, SEED = 27, MERGE_RESULTS = 28, CTX_VALUE = 29, OVERLAY = 30,
+    TMPL0 = 31, TMPL1 = 32, TMPL2 = 33, TMPL3 = 34, SCOPE_BUILD = 35, INJECT = 36,
+    BODY_RESP = 37, L1_INSERT = 38, CPU_PRE = 39, CPU_POST = 40, CPU_RENDER = 41,
+    RENDER_CHAIN = 42, CPU_SVC = 43,
+    // call_worker, per kind: + 0 (loader) / + 20 (jobs)
+    CW_TOTAL = 60, CW_CLAIM = 61, CW_SER = 62, CW_SPAWN_SCHED = 63, CW_ENQUEUE = 64,
+    CW_PROMISE = 65, CW_READ_PARSE = 66, CW_JOIN = 67, CW_RUST_TO_JS = 68, CW_JS_PARSE = 69,
+    CW_JS_HANDLER = 70, CW_JS_STRINGIFY = 71, CW_JS_WRITE = 72, CW_JS_TOTAL = 73,
+    CW_JS_TO_RUST = 74, CW_DISPATCH = 75, CW_REQ_BYTES = 76, CW_RESP_BYTES = 77,
+    JB_TOTAL = 80, JB_CLAIM = 81, JB_SER = 82, JB_SPAWN_SCHED = 83, JB_ENQUEUE = 84,
+    JB_PROMISE = 85, JB_READ_PARSE = 86, JB_JOIN = 87, JB_RUST_TO_JS = 88, JB_JS_PARSE = 89,
+    JB_JS_HANDLER = 90, JB_JS_STRINGIFY = 91, JB_JS_WRITE = 92, JB_JS_TOTAL = 93,
+    JB_JS_TO_RUST = 94, JB_DISPATCH = 95, JB_REQ_BYTES = 96, JB_RESP_BYTES = 97,
+}
+pub const N: usize = 100;
+
+struct Stats {
+    sum: [AtomicU64; N],
+    cnt: [AtomicU64; N],
+}
+
+static ALL: Mutex<Vec<Arc<Stats>>> = Mutex::new(Vec::new());
+
+thread_local! {
+    static MINE: Arc<Stats> = {
+        let s = Arc::new(Stats {
+            sum: std::array::from_fn(|_| AtomicU64::new(0)),
+            cnt: std::array::from_fn(|_| AtomicU64::new(0)),
+        });
+        ALL.lock().push(Arc::clone(&s));
+        s
+    };
+}
+
+pub fn add(stage: usize, v: u64) {
+    MINE.with(|s| {
+        s.sum[stage].fetch_add(v, Relaxed);
+        s.cnt[stage].fetch_add(1, Relaxed);
+    });
+}
+
+pub fn rec(stage: usize, t: Instant) {
+    add(stage, t.elapsed().as_nanos() as u64);
+}
+
+pub fn cpu_on() -> bool {
+    static ON: once_cell::sync::Lazy<bool> =
+        once_cell::sync::Lazy::new(|| std::env::var_os("BRUST_PERF_CPU").is_some());
+    *ON
+}
+
+/// Thread CPU time in ns (only meaningful between two reads on one thread with no await).
+pub fn thread_cpu() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut ts) };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+pub fn epoch_ms() -> f64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_secs_f64()
+        * 1e3
+}
+
+pub fn snapshot_json() -> Vec<u8> {
+    let mut sum = [0u64; N];
+    let mut cnt = [0u64; N];
+    for s in ALL.lock().iter() {
+        for i in 0..N {
+            sum[i] += s.sum[i].load(Relaxed);
+            cnt[i] += s.cnt[i].load(Relaxed);
+        }
+    }
+    let mut m = serde_json::Map::new();
+    for &(i, name) in NAMES {
+        m.insert(name.to_string(), serde_json::json!([sum[i], cnt[i]]));
+    }
+    serde_json::to_vec(&m).unwrap()
+}
