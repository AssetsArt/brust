{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // Resolve the package's own name to the local source so examples/apps in
    // this repo import from `brustjs` exactly like a real installed consumer
    // (mirrors the `exports` map). bun + tsc both honor these paths.
    "paths": {
      "brustjs": ["./runtime/index.ts"],
      "brustjs/routes": ["./runtime/routes.ts"],
      "brustjs/client": ["./runtime/client/index.ts"],
      "brustjs/create": ["./runtime/create.ts"]
    },

    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": ["target"]
}
