  },
  "peerDependencies": {
    "react":     "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@napi-rs/cli":     "^3.0.0",
    "@types/react":     "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript":       "^5.5.0"
  }
}
