{
  "name": "@brust/example-pokedex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "brust build routes.tsx",
    "dev:cf": "wrangler d1 migrations apply TEAM_DB --local --persist-to .wrangler/state && brust dev routes.tsx --target cloudflare",
    "deploy:cf": "brust build routes.tsx --target cloudflare && wrangler deploy -c dist/cf/wrangler.jsonc",
    "cf:migrate:local": "wrangler d1 migrations apply TEAM_DB --local --persist-to .wrangler/state",
    "cf:migrate:remote": "wrangler d1 migrations apply TEAM_DB --remote",
    "start": "brust start",
    "snapshot": "bun scripts/snapshot.ts",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@brust/core": "workspace:*",
    "@elysia/eden": "2.0.0-rc.0",
    "elysia": "2.0.0-rc.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  }
}
