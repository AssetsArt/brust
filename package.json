{
  "name": "brustjs",
  "version": "0.1.14-alpha",
  "description": "Bun + Rust SSR framework — React on the server, Rust everywhere else (napi cdylib + per-worker SharedArrayBuffer).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AssetsArt/brust.git"
  },
  "homepage": "https://github.com/AssetsArt/brust#readme",
  "bugs": "https://github.com/AssetsArt/brust/issues",
  "keywords": [
    "bun",
    "rust",
    "ssr",
    "react",
    "napi",
    "islands",
    "framework"
  ],
  "bin": {
    "brustjs": "./runtime/cli/index.ts"
  },
  "napi": {
    "binaryName": "brust",
    "packageName": "brustjs",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "dependencies": {
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "smol-toml": "^1.6.1",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "brustjs-darwin-x64": "0.1.14-alpha",
    "brustjs-darwin-arm64": "0.1.14-alpha",
    "brustjs-linux-x64-gnu": "0.1.14-alpha",
    "brustjs-linux-arm64-gnu": "0.1.14-alpha",
    "brustjs-linux-x64-musl": "0.1.14-alpha",
    "brustjs-linux-arm64-musl": "0.1.14-alpha"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "type": "module",
  "types": "./runtime/index.d.ts",
  "exports": {
    ".": "./runtime/index.ts",
    "./routes": "./runtime/routes.ts",
    "./create": "./runtime/create.ts"
  },
  "files": [
    "runtime",
    "!runtime/node_modules",
    "!runtime/package.json",
    "!runtime/*.node",
    "!runtime/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cd runtime && bun run build",
    "build:debug": "cd runtime && bun run build:debug",
    "test": "bun test tests/integration.test.ts",
    "dev": "bun runtime/cli/index.ts dev example/pokedex/index.ts",
    "dev:baseline": "bun run bench/apps/bun-serve/index.ts",
    "bench": "bun run scripts/benchmark.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci ."
  }
}
